# Firebase web app config (client-side, safe to expose) — from Firebase console
# Project settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin SDK (server-only secret) — from Firebase console
# Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Anthropic Claude API key — from console.anthropic.com
ANTHROPIC_API_KEY=

# Comma-separated emails that get the doctor role on first sign-in
DOCTOR_EMAILS=

# Set to "true" to enable the doctor's Seed/Clear demo data buttons (see
# docs/DEMO.md). Leave unset in production.
DEMO_MODE=

# Live meal-reading beta (see docs/OWNER-TODO.md "Real AI readings in Preview
# mode"): a SEPARATE deployment from your real Firebase build, not a setting
# alongside it. This deployment must leave every VITE_FIREBASE_* value above
# blank (so isMockMode stays on — no login, no persistence) and set:
#   PREVIEW_AI_ENABLED=true        (server) — the deliberate on/off switch;
#                                   whenever isMockMode is true, meal logging
#                                   always attempts a real reading — this is
#                                   the only thing gating whether it succeeds.
#                                   Turn on only while actively demoing.
#   VITE_PREVIEW_AI_DAILY_LIMIT=    (client, optional) — readings per
#                                   browser/day before the client blocks
#                                   further attempts; defaults to 3
# There is no login on this path, so anyone with the URL can spend Anthropic
# credits while PREVIEW_AI_ENABLED is on — keep the Anthropic account's spend
# cap in place as the real ceiling. "Nothing saved" means nothing is written
# to a database, NOT that meal data never leaves the device: it's still sent
# to Anthropic in transit, same as the real flow.
PREVIEW_AI_ENABLED=
VITE_PREVIEW_AI_DAILY_LIMIT=

# Pantry + grocery list aren't ready for the beta — hidden (nav and routes)
# unless this is "true". Leave unset on the beta deployment; set it locally
# (alongside no VITE_FIREBASE_* config, i.e. mock mode) for your own testing
# of those features ahead of full launch.
VITE_PANTRY_ENABLED=
